    <!-- ============== DYNAMIC HUMANS ============== -->
    <!-- Bounded, seeded, reproducible. Positions are NOT
         published to ROS: perception has to find them. -->
    <actor name="SAR_DynamicPerson_016">
      <!-- PERSON_016  thermal_contrast=HIGH  zone=SAR_ZONE_A -->
      <skin><filename>meshes/SAR_DynamicPerson_016.glb</filename></skin>
      <script>
        <loop>true</loop>
        <auto_start>true</auto_start>
