<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.10">
  <world name="military_world">
    <!-- NON-WEAPONISED search-and-rescue / disaster-response range. -->
    <!-- Generated by export_gazebo.py. Ground truth is NOT in here. -->
    <physics name="default" type="dart">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    <dart><collision_detector>bullet</collision_detector><solver><solver_type>pgs</solver_type></solver></dart></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact" />
    <!-- No world-level Thermal system: it takes no <temperature> at world
         scope and gz-sim logs an error for it. Temperatures are declared
         per-visual, which is where the Thermal system actually reads them. -->
    <gravity>0 0 -9.81</gravity>
    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.36 0.50 0.74 1</background>
      <grid>false</grid>
      <!-- FOG preset: see sar_metadata.json weather_presets -->
      <!-- <fog><type>linear</type><density>0.02</density>
           <start>5</start><end>35</end></fog> -->
    </scene>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 120 0 0 0</pose>
      <diffuse>1.0 0.97 0.92 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.5 0.35 -0.78</direction>
    </light>
    <model name="SAR_Terrain_00_00">
      <static>true</static>
      <pose>-125.0000 -15.0000 0.0000 0.00000 -0.00000 0.00000</pose>
      <!-- {"sar_object": "TERRAIN_TILE", "semantic_class": "GROUND", "terrain_type": "WATER", "traversability": "FORBIDDEN", "traverse_cost": -1.0, "friction_mu": 0.05, "risk_level": "CRITICAL", "thermal_class": "THERMAL_WATER", "sar_sector": "FLOOD"} -->
      <link name="link">
        <visual name="v"><geometry><mesh><uri>meshes/SARM_SAR_Terrain_00_00.glb</uri></mesh></geometry><plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal"><temperature>293.15</temperature></plugin></visual>
        <collision name="c"><geometry><mesh><uri>meshes/SARM_SAR_Terrain_00_00.glb</uri></mesh></geometry><surface><friction><ode><mu>0.05</mu><mu2>0.05</mu2></ode></friction></surface></collision>
      </link>
    </model>
    <model name="SAR_Terrain_00_01">
      <static>true</static>
      <pose>-125.0000 35.0000 0.0000 0.00000 -0.00000 0.00000</pose>
