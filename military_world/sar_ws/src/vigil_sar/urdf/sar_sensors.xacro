<?xml version="1.0"?>
<!-- vigil_sar: dedicated forward-facing THERMAL camera (primary SAR sensor).

     Mounted on a short mast at the front of the body so it looks over the body and
     straight into door openings. All values come from config/sar_mission.yaml
     (thermal_camera.*) through the launch file; the defaults below are the same.

     Gazebo Harmonic thermal_camera + gz-sim-thermal-sensor-system:
       * L16 output: pixel = temperature / resolution  (resolution 0.01 K -> radiometric)
       * the temperature of every object comes from its visual's
         gz::sim::systems::Thermal <temperature> (humans: see build_sar_world.py);
         objects without one render at the world <atmosphere> temperature.
     Topics: /thermal/image_raw (image), /thermal/camera_info. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="thermal_width" default="320"/>
  <xacro:arg name="thermal_height" default="240"/>
  <xacro:arg name="thermal_hfov" default="1.0472"/>
  <xacro:arg name="thermal_rate" default="10"/>
  <xacro:arg name="thermal_x" default="0.52"/>
  <xacro:arg name="thermal_y" default="0.0"/>
  <xacro:arg name="thermal_height_above_ground" default="1.00"/>
  <xacro:arg name="thermal_pitch" default="0.0"/>
  <xacro:arg name="thermal_near" default="0.2"/>
  <xacro:arg name="thermal_far" default="120"/>
  <xacro:arg name="thermal_noise" default="0.0"/>
  <xacro:arg name="thermal_noise_sdf" default="false"/>
  <!-- base_link is 0.5872 m above base_footprint; the ground is 0.052 m below base_footprint
       (measured settle, vision_nav.yaml ground_offset_z). -->
  <xacro:property name="t_z" value="${$(arg thermal_height_above_ground) - 0.052 - 0.5872}"/>
  <xacro:property name="mast_h" value="${t_z - 0.03}"/>

  <link name="thermal_mast">
    <inertial><mass value="0.3"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0002"/></inertial>
    <visual><origin xyz="0 0 ${mast_h / 2}"/><geometry><cylinder radius="0.015" length="${mast_h}"/></geometry><material name="aluminum"/></visual>
    <collision name="thermal_mast_collision"><origin xyz="0 0 ${mast_h / 2}"/><geometry><cylinder radius="0.02" length="${mast_h}"/></geometry></collision>
  </link>
  <joint name="thermal_mast_mount" type="fixed"><parent link="base_link"/><child link="thermal_mast"/>
    <origin xyz="$(arg thermal_x) $(arg thermal_y) 0.03"/></joint>

  <link name="thermal_link">
    <inertial><mass value="0.25"/><inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/></inertial>
    <visual><geometry><box size="0.06 0.08 0.06"/></geometry><material name="rubber"/></visual>
    <collision name="thermal_camera_collision"><geometry><box size="0.06 0.08 0.06"/></geometry></collision>
  </link>
  <joint name="thermal_mount" type="fixed"><parent link="base_link"/><child link="thermal_link"/>
    <origin xyz="$(arg thermal_x) $(arg thermal_y) ${t_z}" rpy="0 $(arg thermal_pitch) 0"/></joint>
  <link name="thermal_optical_frame"/>
  <joint name="thermal_optical_joint" type="fixed"><parent link="thermal_link"/><child link="thermal_optical_frame"/>
    <origin rpy="${-pi/2} 0 ${-pi/2}"/></joint>

  <gazebo reference="thermal_link">
    <sensor name="thermal_camera" type="thermal_camera">
      <topic>/thermal/image_raw</topic>
      <gz_frame_id>thermal_optical_frame</gz_frame_id>
      <update_rate>$(arg thermal_rate)</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <camera>
        <horizontal_fov>$(arg thermal_hfov)</horizontal_fov>
        <image><width>$(arg thermal_width)</width><height>$(arg thermal_height)</height><format>L16</format></image>
        <clip><near>$(arg thermal_near)</near><far>$(arg thermal_far)</far></clip>
        <!-- NO <noise> HERE ON PURPOSE. gz-sensors 8 (Jazzy) crashes the whole Gazebo server
             the moment a thermal_camera sensor carries a gaussian <noise> element, even with
             stddev 0: ThermalCameraSensor::CreateCamera() asks NoiseFactory (not ImageNoiseFactory)
             for the model, gets a null pointer back plus
               [Err] [Noise.cc:63] Image noise requested. Please use ImageNoiseFactory::NoiseModel
             and dereferences it -> SIGSEGV inside SetScene, while the rover's sensors are created.
             Fixed upstream in gz-sensors PR #597 (2026-03), which is newer than Jazzy's 8.x.
             thermal_camera.noise_stddev is applied in software instead (thermal_human_detector.py),
             which is the same Gaussian noise in Kelvin on the same image.
             thermal_noise_sdf:=true puts the element back, for a Gazebo that has the fix. -->
        <xacro:if value="$(arg thermal_noise_sdf)">
          <noise><type>gaussian</type><mean>0</mean><stddev>$(arg thermal_noise)</stddev></noise>
        </xacro:if>
        <optical_frame_id>thermal_optical_frame</optical_frame_id>
      </camera>
      <plugin filename="gz-sim-thermal-sensor-system" name="gz::sim::systems::ThermalSensor">
        <min_temp>253.15</min_temp>
        <max_temp>673.15</max_temp>
        <resolution>0.01</resolution>
      </plugin>
    </sensor>
  </gazebo>
</robot>
