<?xml version="1.0"?>
<sdf version="1.9">
  <model name="rocky_terrain_n4">
    <static>true</static>
    <link name="terrain_link">
      <collision name="terrain_collision">
        <geometry><mesh><uri>model://rocky_terrain_n4/meshes/terrain_collision.stl</uri><scale>1.8 1.8 1.44</scale></mesh></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="terrain_visual">
        <geometry><mesh><uri>model://rocky_terrain_n4/meshes/terrain_visual.obj</uri><scale>1.8 1.8 1.44</scale></mesh></geometry>
        <material>
          <ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><specular>0.02 0.02 0.02 1</specular>
          <pbr><metal>
            <albedo_map>model://rocky_terrain_n4/materials/textures/diffuse.png</albedo_map>
            <normal_map>model://rocky_terrain_n4/materials/textures/normal.png</normal_map>
            <metalness>0</metalness><roughness>0.9</roughness>
          </metal></pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
