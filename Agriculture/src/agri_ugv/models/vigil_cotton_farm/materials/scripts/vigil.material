// VIGIL SIH26126 cotton farm - OGRE materials for Gazebo Classic 11.
// Foliage uses `cull_hardware none` because leaves and grass blades are
// single-sided geometry; without it a robot camera sees holes in every
// plant it looks through. Alpha is deliberately not used anywhere: alpha
// blending needs depth_write off, which corrupts depth-camera output.

material VIGIL/CottonFoliage
{
  technique
  {
    pass
    {
      lighting on
      cull_hardware none
      cull_software none
      ambient 0.108 0.190 0.065 1.0
      diffuse 0.196 0.345 0.118 1.0
      specular 0.03 0.03 0.03 1.0 6.0
    }
  }
}

material VIGIL/CottonStem
{
  technique
  {
    pass
    {
      lighting on
      cull_hardware clockwise
      cull_software back
      ambient 0.134 0.157 0.086 1.0
      diffuse 0.243 0.286 0.157 1.0
      specular 0.03 0.03 0.03 1.0 6.0
    }
  }
}

