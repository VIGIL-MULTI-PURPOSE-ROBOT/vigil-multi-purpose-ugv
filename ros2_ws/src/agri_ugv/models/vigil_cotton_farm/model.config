<?xml version="1.0"?>
<model>
  <name>vigil_cotton_farm</name>
  <version>2.0</version>
  <sdf version="1.10">model.sdf</sdf>
  <author><name>Team VIGIL</name><email>team@vigil.sih</email></author>
  <description>
    VIGIL SIH26126 agricultural test environment. 30 x 30 m Indian cotton field
    at seedling stage (~30 DAS): 23 rows at 4 ft (1.2192 m) pitch, 1 ft
    (0.3048 m) in-row spacing, 2007 plants, with weeds, rocks, uneven terrain,
    a rural surround and dynamic actors. Built for Gazebo Harmonic (gz-sim 8).
  </description>
</model>
